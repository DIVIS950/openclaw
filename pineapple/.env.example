# Pineapple environment variables.
# On Vercel: Project → Settings → Environment Variables. Locally: copy to .env.local.
# Every value here stays on the server. None of them is ever sent to the browser.

# ---------- Required ----------

# Your login password. At least 10 characters; use a long random one (a password manager can make it).
APP_PASSWORD=

# Postgres connection string. On Vercel this is set for you when you add a Neon database
# (Storage → Create Database → Neon). Local example: postgres://pineapple:pineapple@localhost:5432/pineapple
DATABASE_URL=

# Your Claude API key (console.anthropic.com → API Keys). Claude is the voice agent's brain.
# It stays in Vercel: ElevenLabs only gets a separate token for this app's Claude bridge.
ANTHROPIC_API_KEY=

# ElevenLabs API key (ElevenLabs → Developers → API Keys). Needs access to Agents (read + write).
ELEVENLABS_API_KEY=

# ---------- Optional ----------

# Which Claude model answers on the phone. Default: claude-opus-5-5 (smartest).
# claude-haiku-5-5 replies faster and costs far less per call.
PINEAPPLE_CLAUDE_MODEL=
# How long Claude may think before each reply: low (default, fastest) | medium | high
PINEAPPLE_CLAUDE_EFFORT=

# This app's public https address, used to tell ElevenLabs where the Claude bridge is.
# Leave empty on Vercel: the production domain is detected automatically.
APP_URL=

# Normally empty: the app saves these when you tap "Set up voice agent" and "Use" in
# Settings → Voice agent. Set them only if you created the agent with scripts/create-agent.ts.
# If set, they take priority over the values saved in the app.
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
# Only for scripts/create-agent.ts: a long random string, set to the same value here and in Vercel.
LLM_BRIDGE_TOKEN=

# A voice from your ElevenLabs "My Voices" (a native Czech voice sounds best).
# Empty = ElevenLabs default voice. After changing it, tap "Update voice agent" in Settings.
ELEVENLABS_VOICE_ID=
# Empty = eleven_flash_v2_5 (fast, multilingual).
ELEVENLABS_TTS_MODEL=

# Only for ElevenLabs EU data residency accounts: https://api.eu.residency.elevenlabs.io
ELEVENLABS_API_BASE=
