# Required: your Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Optional: change the Claude model (default claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5

# Server (keep HOST=127.0.0.1 if trading is on, so only you can reach it)
PORT=3000
HOST=127.0.0.1

# ---- Polymarket trading (optional, OFF by default) ----
# Reading odds needs no key. Trading needs YOUR OWN wallet. Never share this key.
POLYMARKET_TRADING_ENABLED=false
# Private key of the wallet that signs orders (export it from your Polymarket account / wallet)
POLYMARKET_PRIVATE_KEY=
# 0 = plain wallet (MetaMask key used directly), 1 = email/Magic login, 2 = browser-wallet proxy
POLYMARKET_SIGNATURE_TYPE=0
# Needed for type 1 or 2: the Polymarket proxy address shown on your profile (where your USDC sits)
POLYMARKET_FUNDER_ADDRESS=
# Max dollars per order (safety cap)
POLYMARKET_MAX_TRADE_USD=25
