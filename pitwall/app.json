{
  "expo": {
    "name": "PITWALL Telemetry",
    "slug": "pitwall-telemetry",
    "scheme": "pitwall",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07080A",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pitwall.telemetry"
    },
    "android": {
      "package": "com.pitwall.telemetry",
      "adaptiveIcon": {
        "backgroundColor": "#07080A",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
