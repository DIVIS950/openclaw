# Copy this file to .env and fill in the values. Never commit .env.

# From Google Cloud Console > APIs & Services > Credentials (OAuth client, type "Web application").
GOOGLE_CLIENT_ID=

# From console.anthropic.com > API keys. Used only by the server, never sent to the browser.
ANTHROPIC_API_KEY=

# Optional: only these Google accounts may use the AI (comma-separated emails or @domain).
ALLOWED_EMAILS=

# Optional
PORT=8787
AI_CALLS_PER_MINUTE=20
