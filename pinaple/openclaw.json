// Pinaple main config. Secrets come from ~/.openclaw/.env (never put keys in this file).
{
  agents: {
    defaults: {
      workspace: "~/.openclaw/workspace",
      // Sonnet is the best price/quality for a daily assistant.
      // Change to "anthropic/claude-opus-5-5" for the smartest (and most expensive) brain.
      model: {
        primary: "anthropic/claude-sonnet-5-5",
        fallbacks: ["anthropic/claude-haiku-5-5"],
      },
      // Heartbeat runs cost tokens every time. Off by default to save money.
      // Pinaple can still message you on its own via reminders (cron).
      heartbeat: { every: "0m" },
    },
    entries: {
      main: {
        name: "Pinaple",
        identity: { name: "Pinaple", theme: "loyal personal assistant", emoji: "🍍" },
      },
    },
  },

  // Chat apps (WhatsApp, Telegram) are added by install.sh from your answers.

  // Pinaple talks: every reply also comes as a voice message.
  // Microsoft voice is free (no key). The "Multilingual" voice speaks your language.
  // In chat: "/tts off" = text only, "/tts on" = voice again.
  tts: {
    auto: "always",
    provider: "microsoft",
    providers: {
      microsoft: {
        enabled: true,
        speakerVoice: "en-US-AndrewMultilingualNeural",
      },
    },
  },

  // Semantic memory search needs an OpenAI key. Off by default; Pinaple still
  // remembers through its workspace notes. See README to turn it on.
  memory: { search: { enabled: false } },

  gateway: {
    mode: "local",
    // Private by default. Reach the dashboard through SSH tunnel or Tailscale.
    bind: "loopback",
    port: 18789,
    auth: { mode: "token", token: "${OPENCLAW_GATEWAY_TOKEN}" },
  },
}
