# Copy to ~/.openclaw/.env and fill in. install.sh does this for you.

# Required: the brain. Buy credits at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Required: Telegram bot token from @BotFather (free)
TELEGRAM_BOT_TOKEN=123456789:ABC...

# Required: random password for the dashboard. install.sh generates it.
OPENCLAW_GATEWAY_TOKEN=change-me

# Optional: phone calls (see extras/voice-call.md). Costs money at Twilio.
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
