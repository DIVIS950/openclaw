# Example of ~/.openclaw/.env. install.sh creates this file for you from your answers.

# Required: the brain. Buy credits at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Random password for the dashboard. install.sh generates it.
OPENCLAW_GATEWAY_TOKEN=change-me

# Where you chat with Pinaple: whatsapp, telegram, or whatsapp,telegram
PINAPLE_CHANNELS=whatsapp
# Your own WhatsApp number (Pinaple only answers you, in "Message yourself")
PINAPLE_WHATSAPP_NUMBER=+420601234567

# Only for Telegram: bot token from @BotFather (free)
# TELEGRAM_BOT_TOKEN=123456789:ABC...

# Optional: understand your voice messages. Free at https://console.groq.com/keys
# GROQ_API_KEY=gsk_...

# Optional: phone calls (see README). Costs money at Twilio.
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
