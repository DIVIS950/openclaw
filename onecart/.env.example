# Real Shopify stores (Storefront API). Comma-separated "domain|storefront-token" pairs.
# Storefront tokens are public and safe to ship in an app.
EXPO_PUBLIC_SHOPIFY_STORES=

# Gmail import: Google OAuth client IDs (Google Cloud Console > APIs & Services > Credentials).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
