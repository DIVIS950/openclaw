# --- AI (required for real analysis; without it the app runs in demo mode) ---
ANTHROPIC_API_KEY=
# SNAPSELL_MODEL=claude-opus-5

# --- eBay official API (optional) — see README "Connect eBay" ---
# EBAY_ENV=production            # or sandbox
# EBAY_MARKETPLACE_ID=EBAY_US    # EBAY_GB, EBAY_DE, EBAY_FR, EBAY_IT, EBAY_ES, EBAY_PL ...
# EBAY_CONTENT_LANGUAGE=en-US
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# EBAY_REFRESH_TOKEN=
# EBAY_FULFILLMENT_POLICY_ID=
# EBAY_PAYMENT_POLICY_ID=
# EBAY_RETURN_POLICY_ID=
# EBAY_LOCATION_KEY=

# --- Browser automation (Facebook Marketplace, Vinted) ---
# SNAPSELL_CHROME_PATH=          # custom Chrome/Chromium binary; default = installed Chrome, else bundled Chromium
# SNAPSELL_HEADLESS=0

# PORT=8787
