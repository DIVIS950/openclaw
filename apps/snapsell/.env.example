# ─── AI (required for real analysis; without it SnapSell runs in demo mode) ───
ANTHROPIC_API_KEY=
# SNAPSELL_MODEL=claude-opus-5

# ─── Your public address (needed once SnapSell is online, for Google/eBay login) ───
# e.g. the Tailscale Funnel address: https://your-computer.your-tailnet.ts.net
PUBLIC_URL=

# ─── Sign in with Google (protects your SnapSell when it's online) ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Who may sign in. Empty = only the first Google account that signs in.
ALLOWED_EMAILS=

# ─── Google Lens price search (both optional) ───
# Google Cloud Vision "web detection", 1,000 free photos/month
GOOGLE_VISION_API_KEY=
# SerpApi Google Lens with shop prices, 100 free searches/month (needs PUBLIC_URL)
SERPAPI_KEY=

# ─── eBay "Log in with eBay" (your eBay developer app) ───
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# The RuName from eBay's developer portal (User Tokens → "Get a Token from eBay via Your Application")
EBAY_RUNAME=
# EBAY_ENV=production            # or sandbox
# EBAY_MARKETPLACE_ID=EBAY_US    # EBAY_GB, EBAY_DE, EBAY_FR, EBAY_IT, EBAY_ES, EBAY_PL ...
# EBAY_CONTENT_LANGUAGE=en-US

# PORT=8787
