# Orbit settings. Add these in Vercel → Project → Settings → Environment Variables,
# then redeploy. Everything is optional except where noted; missing parts switch off.

# --- Required for the admin page and Google sign-in
# Any long random text, e.g. from https://generate-secret.vercel.app/32
AUTH_SECRET=
# Password for https://YOUR-APP/admin (where you process orders)
ADMIN_PASSWORD=

# --- AI: search, "Should you buy it?", coupons, assistant (console.anthropic.com)
ANTHROPIC_API_KEY=

# --- Payments: Apple Pay, Google Pay, cards (dashboard.stripe.com → Developers → API keys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Developers → Webhooks → endpoint https://YOUR-APP/api/stripe/webhook
# (events: payment_intent.amount_capturable_updated, payment_intent.canceled)
STRIPE_WEBHOOK_SECRET=
# Orbit's service fee in percent (minimum 1 EUR per order)
ORBIT_FEE_PERCENT=3

# --- Order storage: Upstash Redis (Vercel → Storage → Upstash for Redis sets
# KV_REST_API_URL / KV_REST_API_TOKEN automatically; these names work too)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Google sign-in + Gmail parcel tracking (console.cloud.google.com)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ORBIT_GMAIL=0
