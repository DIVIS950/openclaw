# Everything is optional. With no keys, Orbit runs in demo mode with sample data.

# Auth.js secret (required in production): `npx auth secret`
AUTH_SECRET=

# Google sign-in (+ Gmail parcel import). Create an OAuth client at
# https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Set to 1 to also request read-only Gmail access for parcel tracking.
ORBIT_GMAIL=0

# Claude AI assistant, store safety checks, price research and delivery ETAs.
ANTHROPIC_API_KEY=
