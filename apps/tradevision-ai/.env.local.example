# TradeVision AI — Environment Variables
# Copy this file to .env.local and fill in your API keys

# Anthropic API — Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Alpha Vantage — Free tier: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Finnhub — Free tier: https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_api_key_here

# NewsAPI — Free tier: https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key_here

# Optional: Node env
NODE_ENV=development
